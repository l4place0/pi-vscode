{
  "name": "pi-vscode-fork",
  "displayName": "Pi VSCode Fork",
  "version": "0.1.0",
  "description": "VS Code extension for pi coding agent",
  "categories": [
    "AI",
    "Chat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pi0/pi-vscode"
  },
  "publisher": "pi0",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts -w",
    "package": "pnpm build && pnpm exec vsce package --no-dependencies",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsgo --noEmit --skipLibCheck",
    "test:unit": "vitest run",
    "test:integration": "node test/integration/run.mjs",
    "test:pi": "node scripts/pi-smoke.mjs",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "ovsx": "^0.10.9",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rolldown": "^1.0.0-rc.10",
    "vitest": "^4.1.0"
  },
  "contributes": {
    "icons": {
      "pi-vscode-fork-logo": {
        "description": "Pi logo icon",
        "default": {
          "fontPath": "assets/fonts/pi-icons.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "pi-vscode-fork.chat",
        "fullName": "Pi VSCode Fork",
        "name": "pi-fork",
        "description": "Chat with Pi coding agent",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "pi-vscode-fork.open",
        "title": "Pi Fork: Open",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-vscode-fork.openWithFile",
        "title": "Pi Fork: Open with File",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-vscode-fork.sendSelection",
        "title": "Pi Fork: Send Selection"
      },
      {
        "command": "pi-vscode-fork.updatePackages",
        "title": "Pi Fork: Upgrade Pi and Packages"
      },
      {
        "command": "pi-vscode-fork.openInNewWindow",
        "title": "Pi Fork: Open in New Window",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-vscode-fork.openWithFile",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pi-vscode-fork.openWithFile",
          "group": "navigation"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "pi-vscode-fork.terminal-profile",
          "title": "Pi Fork",
          "icon": "pi-vscode-fork-logo"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-vscode-fork",
          "title": "Pi Fork",
          "icon": "assets/logo.svg"
        }
      ]
    },
    "views": {
      "pi-vscode-fork": [
        {
          "type": "webview",
          "id": "pi-vscode-fork.packages",
          "name": "Packages"
        }
      ]
    },
    "configuration": {
      "title": "Pi VSCode Fork",
      "properties": {
        "pi-vscode-fork.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the pi binary. Leave empty for auto-detection."
        }
      }
    },
    "keybindings": [
      {
        "command": "pi-vscode-fork.open",
        "key": "ctrl+alt+3"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.110.0"
  },
  "packageManager": "pnpm@10.32.1"
}
